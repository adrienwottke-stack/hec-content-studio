# Local: npm install, copy this file to .env, npm start
PORT=4320
HOST=127.0.0.1
DATA_DIR=./data
ANALYSIS_PROVIDER=codex

# Optional alternative: set ANALYSIS_PROVIDER=gemini to use a separate provider.
# In Codex mode this key is unused. FFmpeg renders locally in either mode.
GEMINI_API_KEY="REPLACE_WITH_YOUR_OWN_VALUE"
GEMINI_MODEL=gemini-3.8-flash

# Required in production; use a long, unique password.
STUDIO_USER=hec
STUDIO_PASSWORD="REPLACE_WITH_YOUR_OWN_VALUE"

# Optional. FFmpeg and ffprobe must be available on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_FILE_MB=32768
MAX_SESSION_MB=2048
MAX_FILES=30
# 0 uses the actual free space on DATA_DIR, retaining the reserve below.
MAX_STORAGE_MB=0
STORAGE_RESERVE_MB=3072
UPLOAD_CHUNK_MB=16
# For deploy/compose.storage.yml only, an existing directory on a mounted volume.
STUDIO_VOLUME_PATH=
MAX_SOURCE_SECONDS=600
MAX_SESSION_SECONDS=1200
RENDER_WIDTH=1080
RENDER_FPS=30
